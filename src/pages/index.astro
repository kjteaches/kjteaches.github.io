---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { readingTime } from "../lib/post-meta";

const featuredPosts = (
  await getCollection("blog", ({ data }) => data.featured && !data.draft)
).sort((a, b) => b.data.order - a.data.order);

const featuredProjects = (
  await getCollection("projects", ({ data }) => data.featured && !data.draft)
).sort((a, b) => a.data.order - b.data.order);

const samples = [
  {
    title: "Integrate the SDK into your web application",
    description: "SDK integration guide in MDX via ReadMe.io",
    url: "https://developer.goacoustic.com/acoustic-exp-analytics/docs/install-tealeaf-web-sdk-copy",
  },
  {
    title: "Render HTML pages from the headless CMS",
    description: "API documentation in MDX via ReadMe.io",
    url: "https://developer.goacoustic.com/acoustic-content/docs/render-an-html-article-page-with-templates-and-layout",
  },
  {
    title: "How to model a REST API resource",
    description: "Developer tutorial",
    url: "https://www.advancedcustomfields.com/blog/rest-api-resource/",
  },
  {
    title: "API throttling",
    description: "Knowledge base entry (glossary)",
    url: "https://getstream.io/glossary/api-throttling/",
  },
];
---

<Base title="KJ | Technical Writer & Software Engineer" noindex={true}>
  <main>
    <div class="group group--name">
      <p class="whisper">I&rsquo;m Kevin but everyone calls me</p>
      <h1 class="shout name">
        <button
          class="trigger"
          type="button"
          aria-expanded="true"
          aria-controls="panel-kj"
        >
          KJ
        </button>
      </h1>
      <div class="panel open" id="panel-kj">
        <div class="panel-inner">
          <div class="panel-body">
            <p class="bio">
              I figure out where people get stuck and make sure it doesn't happen again.
            </p>
            <div class="socials">
              <a target="_blank" href="https://www.linkedin.com/in/kevin-m-3236782b5/">LinkedIn</a>
              <a target="_blank" href="https://github.com/kjteaches">GitHub</a>
              <a target="_blank" href="https://medium.com/@kjteaches">Medium</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- <div class="rule" aria-hidden="true"></div> -->

    <div class="group">
      <p class="shout role">
        <button
          class="trigger"
          type="button"
          aria-expanded="false"
          aria-controls="panel-writer"
        >
          Technical writer
        </button>
      </p>
      <div class="panel" id="panel-writer">
        <div class="panel-inner">
          <div class="panel-body">
            <div class="items">
              {samples.map((sample) => (
                <a class="item" target="_blank" href={sample.url}>
                  <h3>{sample.title}</h3>
                  <p>{sample.description}</p>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="group">
      <p class="whisper">with previous experience as a</p>
      <div class="shout prev">
        <span class="prev-line"
          ><button
            class="trigger"
            type="button"
            aria-expanded="false"
            aria-controls="panel-engineer"
          >
            Software engineer
          </button>
          <span class="amp">&amp;</span></span
        >
        <div class="panel" id="panel-engineer">
          <div class="panel-inner">
            <div class="panel-body">
              <div class="items">
                {featuredProjects.map((project) => (
                  <a
                    class="item"
                    href={project.data.url ?? `/projects/${project.id}`}
                    {...(project.data.url ? { target: "_blank" } : {})}
                  >
                    <h3>{project.data.title}</h3>
                    <p>{project.data.description}</p>
                  </a>
                ))}
              </div>
              <a class="btn" href="/projects">See all projects</a>
            </div>
          </div>
        </div>

        <span class="prev-line"
          ><button
            class="trigger"
            type="button"
            aria-expanded="false"
            aria-controls="panel-teacher"
          >
            Computer science teacher
          </button></span
        >
      </div>

      <div class="panel" id="panel-teacher">
        <div class="panel-inner">
          <div class="panel-body">
            <p class="bio">
              I volunteer as an Intro to Computer Science instructor at <a
                target="_blank"
                href="https://www.zetech.ac.ke/">Zetech University</a
              >, with a self-developed
              curriculum covering the fundamentals through hands-on
              projects.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="group">
      <div>
        <button
          class="trigger posts-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="panel-posts"
        >
          Recent posts
        </button>
      </div>
      <div class="panel" id="panel-posts">
        <div class="panel-inner">
          <div class="panel-body">
            <div class="posts-list">
              {featuredPosts.map((post) => (
                <div class="post-row">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a><span class="time">{readingTime(post.body)}</span>
                </div>
              ))}
            </div>
            <a class="btn" href="/blog">View all posts</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <div class="hint">
    <div class="hint-bubble" id="hint-text" role="tooltip">
      Hover over some text!
    </div>
    <button
      class="hint-btn"
      type="button"
      aria-expanded="false"
      aria-controls="hint-text"
      aria-label="How this page works"
    >
      <span>?</span>
    </button>
  </div>

  <script is:inline src="/script.js" defer></script>
</Base>